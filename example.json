{
    "db_name": "my_cool_database",
    "columns": {
        "id": {
            "type": "PRIMARY_KEY",
            "nextkey": 1000
        },
        "firstName": "FIRST_NAME",
        "lastName": {
            "type": "LAST_NAME",
            "unique": true,
            "mufm": 5
        },
        "personName": "FULL_NAME",
        "company": "COMPANY_NAME",
        "address_street": "STREET",
        "address_housenumber": "HOUSENUMBER",
        "address_town": "TOWN",
        "address_plz": "PLZ",
        "some_place": "STREET_HOUSENUMBER",
        "price": {
            "type": "MONEY",
            "max": 1000
        },
        "discount": {
            "type": "FLOAT",
            "max": 0.5,
            "acc": 10
        },
        "amount": {
            "type": "INTEGER",
            "min": 1,
            "max": 50
        },
        "somedate": {
            "type": "DATE",
            "start": "1970-01-01",
            "end": "-1y"
        },
        "sometime": "TIME",
        "somedatetime": "DATE_TIME",
        "category": {
            "type": "VALUES",
            "values": [
                "Category A",
                "Category B",
                "Category C"
            ]
        },
        "somestringthing": {
            "type": "FORMAT_STRING",
            "regex": "[A-Z]\\-NR\\d{7}"
        },
        "word": "RANDOM_STRING"
    },
    "amount": 100
}